# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Required for --target anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults shown.
SENTINEL_DB_PATH=sentinel.db
SENTINEL_TARGET_MODEL=claude-haiku-4-5
SENTINEL_MAX_TOKENS=1024

# Optional, scoring (--scorer llm-judge).
SENTINEL_JUDGE_MODEL=claude-haiku-4-5
SENTINEL_JUDGE_MAX_TOKENS=512
